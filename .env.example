# Supabase Configuration (Public Client Variables)
VITE_SUPABASE_URL="{{SUPABASE_URL}}"
VITE_SUPABASE_PUBLIC_KEY="{{SUPABASE_KEY}}"

# Supabase Server-Side Configuration (Keep secret on server)
SUPABASE_URL="{{SUPABASE_URL}}"
SUPABASE_PUBLIC_KEY="{{SUPABASE_KEY}}"
SUPABASE_SERVICE_ROLE_KEY="{{SUPABASE_SERVICE_ROLE_KEY}}"

# OpenRouter AI Configuration (Server-Side Only — Never expose in frontend)
OPENROUTER_API_KEY="{{OPENROUTER_API_KEY}}"

# Real-Time Web Research APIs (Server-Side Only — Never expose in frontend)
FIRECRAWL_API_KEY="{{FIRECRAWL_API_KEY}}"
SPIDER_API_KEY="{{SPIDER_API_KEY}}"

# Application URL
APP_URL="http://localhost:3000"
